# ============================================================
# VOXENTRAAI — REAL TELEPHONY HELPLINE ENVIRONMENT TEMPLATE
# ============================================================

# Programmable Telephony Provider ('twilio' or 'exotel')
TELEPHONY_PROVIDER="twilio"

# Public Base URL for Webhooks & Audio Playback (e.g. ngrok tunnel or Render URL)
VOICE_REGISTER_BASE_URL="https://your-domain.ngrok-free.app"

# Webhook Security
TELEPHONY_WEBHOOK_VALIDATE_SIGNATURE=False
TELEPHONY_MAX_SILENCE_RETRIES=3

# Twilio Credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+19130000000"

# Exotel Credentials (https://my.exotel.com)
EXOTEL_ACCOUNT_SID="your_exotel_sid"
EXOTEL_API_KEY="your_exotel_key"
EXOTEL_API_TOKEN="your_exotel_token"
EXOTEL_CALLER_ID="080XXXXXXXX"
EXOTEL_WEBHOOK_SECRET="your_exotel_secret"

# Backend & Database
DATABASE_URL="sqlite:///./backend/voxentra.db"
SECRET_KEY="your_secret_key_here"
ENVIRONMENT="production"
DEBUG=False

# Vite Frontend API Target
VITE_API_URL="http://localhost:8000"
