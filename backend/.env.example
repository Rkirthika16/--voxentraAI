# ============================================================
# VOXENTRAAI REAL TELEPHONY & BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# General Application Settings
PROJECT_NAME="VoxentraAI"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=False
API_V1_STR="/api/v1"

# Security (Generate a strong 32+ character random secret in production)
SECRET_KEY="replace_with_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite:
DATABASE_URL="sqlite:///./voxentra.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://user:password@hostname:5432/dbname"

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app,https://voxentra-frontend.onrender.com"

# Speech-to-Text & Multilingual AI Engine
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
ENABLE_FALLBACK_AI=True

# File Storage & Uploads
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=26214400

# ============================================================
# REAL TELEPHONY HELPLINE CONFIGURATION (Twilio / Exotel)
# ============================================================
# Choose telephony provider: 'twilio' or 'exotel'
TELEPHONY_PROVIDER="twilio"

# Public HTTPS URL of your deployed backend (or ngrok/Cloudflare tunnel for dev)
# This URL is used by Twilio/Exotel to fetch audio and send speech webhooks
VOICE_REGISTER_BASE_URL="https://your-domain.ngrok-free.app"

# Webhook Security & Idempotency
TELEPHONY_WEBHOOK_VALIDATE_SIGNATURE=False
TELEPHONY_MAX_SILENCE_RETRIES=3
TELEPHONY_IDEMPOTENCY_CACHE_TTL_SEC=86400

# Twilio Programmable Voice & SMS Configuration
# Obtain credentials from: https://console.twilio.com
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+19130000000"

# Exotel Telephony Configuration (Alternative for Indian PSTN)
# Obtain credentials from: https://my.exotel.com
EXOTEL_ACCOUNT_SID="your_exotel_account_sid"
EXOTEL_API_KEY="your_exotel_api_key"
EXOTEL_API_TOKEN="your_exotel_api_token"
EXOTEL_CALLER_ID="080XXXXXXXX"
EXOTEL_WEBHOOK_SECRET="your_exotel_webhook_secret"

# Optional WebSocket Telephony Audio Stream
TELEPHONY_STREAM_URL="/api/v1/telephony/voice/stream"

# AI Providers (Optional - for enhanced reasoning)
GEMINI_API_KEY=""
