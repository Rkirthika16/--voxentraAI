PROJECT_NAME="VoxentraAI"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="replace_this_with_a_super_secret_key_in_production_voxentra_ai"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite:///./voxentra.db"
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
ENABLE_FALLBACK_AI=True
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=26214400

# Optional Exotel
EXOTEL_ACCOUNT_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_CALLER_ID=""
EXOTEL_WEBHOOK_SECRET=""
