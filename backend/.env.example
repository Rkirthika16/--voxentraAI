# ============================================================
# VOXENTRAAI BACKEND ENVIRONMENT CONFIGURATION
# ============================================================

# General Application Settings
PROJECT_NAME="VoxentraAI"
VERSION="1.0.0"
ENVIRONMENT="production"
DEBUG=False
API_V1_STR="/api/v1"

# Security (CRITICAL: Generate a strong 32+ character random string in production)
SECRET_KEY="replace_with_a_secure_random_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# SQLite (Local Dev / Lightweight):
DATABASE_URL="sqlite:///./voxentra.db"
# PostgreSQL (Production / Supabase / Neon / Render Postgres):
# DATABASE_URL="postgresql://user:password@hostname:5432/dbname"

# CORS Configuration (Comma-separated origins of your deployed frontend URLs)
# Add your production frontend URL (e.g. Vercel, Render, custom domain)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://your-frontend.vercel.app,https://voxentra-frontend.onrender.com"

# AI & Offline Speech Recognition
WHISPER_MODEL_SIZE="base"
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
ENABLE_FALLBACK_AI=True

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=26214400

# Telephony / IVR Integration (Optional)
TELEPHONY_PROVIDER="exotel"
EXOTEL_ACCOUNT_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_CALLER_ID=""
EXOTEL_WEBHOOK_SECRET=""

TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
